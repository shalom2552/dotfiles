#!/usr/bin/env bash
# Aliases only, keep it portable for bash, zsh and fish.

# =============================================================================
# ALIASES
# =============================================================================

# Core
alias v='nvim'
alias q='exit'
alias zz='cdi'

# flags
alias cp='cp -vi'
alias mv='mv -vi'
alias rm='rm -I'
alias mkdir='mkdir -pv'

# Replacements
alias ls="eza -G --icons --group-directories-first --git"
alias la="eza -a --icons --group-directories-first --git"
alias ll="eza -l --header --icons --group-directories-first --git"
alias lsa="eza -al --header --icons --group-directories-first --git"
alias tree="eza -T --icons --git"
alias df='duf'

# Fuzzy tools
alias vf='fzf | xargs -r $EDITOR'
alias bf='fzf | xargs -r bat'
alias cf='fzf | xargs -r cat'
alias wf='fzf | xargs -r wc -l'

# System
alias vol='amixer set Master'
alias lock='xdg-screensaver lock'

# Search
alias hl='rg --passthru --color=always'

# Git
alias ga='git add'
alias gap='git add --patch'
alias gau='git add --update'
alias gaa='git add --all --verbose'
alias gp='git push'
alias gpl='git pull'
alias gpf='git push --force'
alias gst='git status -u'
alias gdf='git diff'
alias gcm='git commit -m'
alias gco='git checkout'
alias gsw='git switch'
alias grs='git reset --hard HEAD'

# Tools
alias lgt='lazygit'
alias ldk='lazydocker'

# Tmux
alias tls='tmux ls'
alias tk='tmux kill-session -t'
alias t='tmux new-session -A -s'

# Bin scripts
alias tdev='tmux-dev'
alias gc='gcommit'

