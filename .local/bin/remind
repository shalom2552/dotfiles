#!/usr/bin/bash
# Simple cli reminder. Add rm and list reminders.
set -euo pipefail

DATADIR="$HOME/.local/share/remind"
DATAFILE="$DATADIR/reminders"
mkdir -p "$DATADIR"
touch "$DATAFILE"

CAYN="\e[36m"
RST="\e[0m"

note() { echo -e "$@"; }
die() { echo -e "remind: $@"; exit 1; }

usage() {
    cat <<EOF
Commands
  add    add a new reminder to the list
  rm N   remove a reminder by index
  ls     list current active reminders

Flags
    -h,--help show help message
EOF
}

help() {
    cat <<EOF
Track quick reminders.

EOF
    usage
}

die-usage() {
    echo -e "remind: $@"
    usage
    exit 1
}

add-reminder() {
    echo -e "$RST""$*""$RST" >> "$DATAFILE"
    note "reminder added: $*"
}

remove-reminder() {
    local count; count="$(wc -l < "$DATAFILE")"
    [[ "$1" =~ ^[,0-9]+$ ]] || die "rm: need a number"
    [[ "$1" -le "$count" ]] || die "rm: list-size=${count}, got:$1"
    sed -i "${1//,/d;}d" "$DATAFILE"
    note "Removed reminder: $1"
}

list-reminders() {
    echo -e "${CAYN}Reminders:$RST"
    if [[ -s "$DATAFILE" ]]; then
        nl "$DATAFILE" 
    else
        echo "    No reminders"
    fi
}

count-reminders() {
    if [[ -s "$DATAFILE" ]]; then
        wc -l < "$DATAFILE"
    fi
}

clear-all() {

    read -p "Remove all reminders? [y/N]:" -n 1 -r
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo
        rm -f "$DATAFILE" && note "Removed all reminders"
    fi
}

main() {
    case "${1-}" in
        add)
            shift 1
            add-reminder "$@"
            ;;
        rm)
            shift 1
            remove-reminder "$@"
            ;;
        ls)
            list-reminders
            ;;
        count)
            count-reminders
            ;;
        clear)
            clear-all
            ;;
        -h|--help)
            help
            ;;
        "")
            list-reminders
            ;;
        *)
            die-usage "invalid command '$1'"
            ;;
    esac
}

main "$@"

