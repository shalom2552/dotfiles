#!/usr/bin/env bash
# ~/.local/bin/power
# Author: Gemini
# Date:   2026-04-18
#
# Unified power menu powered by fzf.
#
# Usage: power [options] [query]
#
# Options:
#   -p, --print   Print the command instead of executing it.
#   -h, --help    Show this help message.

set -uo pipefail

# ==== COLORS (Catppuccin Mocha) ====

C_BLUE='\x1b[38;2;137;180;250m'
C_CYAN='\x1b[38;2;137;220;235m'
C_YELLOW='\x1b[38;2;249;226;175m'
C_PURPLE='\x1b[38;2;203;166;247m'
C_ORANGE='\x1b[38;2;250;179;135m'
C_RED='\x1b[38;2;243;139;168m'
C_RESET='\x1b[0m'

# ==== ARGS ====

usage() {
    cat <<EOF
Usage: power [options] [query]

Fuzzy system power menu.

Options:
  -p, --print     Print the selected command instead of executing.
  -h, --help      Show this help message.

Arguments:
  query           (Optional) Initial search string. If only one match
                  exists, it is selected automatically.
EOF
}

PRINT_MODE=false
QUERY=""

for arg in "$@"; do
    case "$arg" in
        -p|--print) PRINT_MODE=true ;;
        -h|--help)  usage; exit 0 ;;
        -*) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
        *)  [[ -z "$QUERY" ]] && QUERY="$arg" ;;
    esac
done

# ==== ACTIONS ====

LOCK="Lock"
LOGOUT="Logout"
SUSPEND="Suspend"
REBOOT="Reboot"
SHUTDOWN="Shutdown"

# Format: "Icon|Color|Label|Command"
# Symbols: 󰌾 Lock, 󰗼 Logout, 󰖔 Suspend, 󰜉 Reboot, 󰐥 Shutdown
ACTIONS=(
    "󰌾|${C_BLUE}|${LOCK}|loginctl lock-session || hyprlock"
    "󰗼|${C_YELLOW}|${LOGOUT}|loginctl terminate-user \"$USER\""
    "󰖔|${C_PURPLE}|${SUSPEND}|systemctl suspend"
    "󰜉|${C_ORANGE}|${REBOOT}|systemctl reboot"
    "󰐥|${C_RED}|${SHUTDOWN}|systemctl poweroff"
)

# ==== HELPERS ====

confirm() {
    printf '\e[?25l\n\n  %b%s%b\n  %b❯%b %s now? %b[Y/n]%b\n ' \
        "$C_YELLOW" "──────────────────" "$C_RESET" \
        "$C_YELLOW" "$C_RESET" \
        "$1" \
        "$C_BLUE" "$C_RESET" >/dev/tty
    read -r -n 1 reply </dev/tty
    printf '\e[?25h' >/dev/tty
    [[ "${reply,,}" != "n" ]]
}

# ==== PICK ====

list_actions() {
    for entry in "${ACTIONS[@]}"; do
        IFS='|' read -r icon color label cmd <<< "$entry"
        printf "%b%s%b  %-8s\t%s\n" "$color" "$icon" "$C_RESET" "$label" "$cmd"
    done
}

selected=$(list_actions | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --query="$QUERY" \
    --select-1 \
    --prompt="> " \
    --pointer="▶" \
    --marker="✓" \
    --margin=20%,30% \
    --border-label=" System " \
    --no-info \
    --border=rounded \
    --height=10% \
    --no-preview \
    --gutter=' ' \
    --color=fg:#cdd6f4,bg:-1,hl:#cba6f7 \
    --color=fg+:#cdd6f4,bg+:-1,hl+:#89dceb \
    --color=info:#89b4fa,prompt:#89dceb,pointer:#89dceb \
) || exit 0

# ==== EXECUTE ====

CONFIRM_LABELS=("$LOGOUT" "$REBOOT" "$SHUTDOWN")

label=$(echo "$selected" | cut -f1 | sed 's/^[^ ]* *//')
cmd=$(echo "$selected" | cut -f2-)

needs_confirm=false
for cl in "${CONFIRM_LABELS[@]}"; do
    [[ "$label" == *"$cl"* ]] && needs_confirm=true && break
done

if [[ -n "$cmd" ]]; then
    if [[ "$PRINT_MODE" == true ]]; then
        echo "$cmd"
    else
        if [[ "$needs_confirm" == true ]]; then
            confirm "$cl" || exit 0
        fi
        bash -c "$cmd"
    fi
fi
