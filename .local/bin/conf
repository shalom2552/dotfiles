#!/usr/bin/env bash

DOTFILES="$HOME/.dotfiles"
CONFDIR="$HOME/.config"

# ========== OPTIONS ==========
declare -A options=(
    ["conf"]="$HOME/.local/bin/conf"

    ["zsh"]="$ZDOTDIR/.zshrc"
    ["alias"]="$ZDOTDIR/.aliases"
    ["local"]="$ZDOTDIR/.localconf"
    ["fzf"]="$ZDOTDIR/.fzfrc"
    ["kitty"]="$CONFDIR/kitty/kitty.conf"
    ["tmux"]="$CONFDIR/tmux/tmux.conf"
    ["starship"]="$CONFDIR/starship.toml"
    ["fastfetch"]="$CONFDIR/fastfetch/config.jsonc"
    ["lazygit"]="$CONFDIR/lazygit/config.yml"

    ["bashrc"]="$HOME/.bashrc"
    ["zshenv"]="$HOME/.zshenv"
    ["nvim"]="$CONFDIR/nvim"

    ["cht"]="$HOME/.local/bin/cht"
    ["clip"]="$HOME/.local/bin/clip"
    ["conf"]="$HOME/.local/bin/conf"
    ["fzf-preview"]="$HOME/.local/bin/fzf-preview"
    ["launch"]="$HOME/.local/bin/launch"
    ["n"]="$HOME/.local/bin/n"
    ["nb"]="$HOME/.local/bin/nb"
    ["pkgf"]="$HOME/.local/bin/pkgf"
    ["power"]="$HOME/.local/bin/power"
    ["psf"]="$HOME/.local/bin/psf"
    ["rgf"]="$HOME/.local/bin/rgf"
    ["speak"]="$HOME/.local/bin/speak"
    ["tmux-dev"]="$HOME/.local/bin/tmux-dev"
    ["track"]="$HOME/.local/bin/track"
)

# ========== GLOABALS ==========
BAT_FLGS=(--color=always --style=plain --map-syntax '\*.conf:INI')
FZF_FLGS=(--ansi --cycle --with-nth=1 --delimiter="\t" --layout=reverse-list --preview-window right:75%)

# ========== LOGIC ==========
choice=$(
    for k in "${!options[@]}"; do
        printf "%s\t%s\n" "$k" "${options[$k]}"
    done \
    | fzf "${FZF_FLGS[@]}" \
        --preview "bat ${BAT_FLGS[*]} {2}" \
        --accept-nth 2
) || exit 0

$EDITOR "$choice"

