#!/usr/bin/env bash
# speak - text to speach using piper
set -euo pipefail

# --- GLOBALS -----------------------------------
MODEL_DIR="$HOME/.local/share/piper-voices"
BASE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main"

# registry: short-name -> huggingface subpath
declare -A MODELS=(
    [male]="en/en_US/hfc_male/medium/en_US-hfc_male-medium"
    [female]="en/en_US/hfc_female/medium/en_US-hfc_female-medium"
    [amy]="en/en_US/amy/medium/en_US-amy-medium"
    [lessac]="en/en_US/lessac/medium/en_US-lessac-medium"
)

MODEL="male" # default voice
MODEL_PATH="$MODEL_DIR/$(basename "${MODELS[$MODEL]}").onnx"

# --- HELPERS -----------------------------------
usage() {
    echo ""
    echo "Usage: speak <text|file>"
    echo ""
    echo "Options:"
    echo "  -h, --help          Show this help message"
    echo "  -v, --voice <name>  Specify voice model (default: male)"
    echo ""
    echo "Available voices:"
    echo "  $(echo "${!MODELS[*]}")"
    exit 1
}

confirm() {
    read -r -p "$1 [Y/n] " reply
    [[ ! "$reply" =~ ^[Nn]$ ]]
}

model_exists() {
    [[ -f "$1" && -f "${1}.json" ]]
}

resolve_model_path() {
    echo "$MODEL_DIR/$(basename "${MODELS[$1]}").onnx"
}

download_model() {
    local subpath="${MODELS[$1]}"
    mkdir -p "$MODEL_DIR"
    curl -L --fail -o "$MODEL_DIR/$(basename "$subpath").onnx" "$BASE_URL/${subpath}.onnx"
    curl -L --fail -o "$MODEL_DIR/$(basename "$subpath").onnx.json" "$BASE_URL/${subpath}.onnx.json"
}

# --- FUNCTIONS -----------------------------------
ensure_piper() {
    if ! command -v piper-tts &>/dev/null; then
        echo "piper-tts is not installed."
        if confirm "Install it now via pip?"; then
            pip install --break-system-packages piper-tts 2>/dev/null || pip install piper-tts
        else
            echo "Aborting: piper-tts required."
            exit 1
        fi
    fi
}

ensure_model() {
    MODEL_PATH="$(resolve_model_path "$MODEL")"
    if ! model_exists "$MODEL_PATH"; then
        echo "Voice model '$MODEL' not found." >&2
        if confirm "Download it now?"; then
            download_model "$MODEL"
        else
            echo "Aborting: model required." >&2
            exit 1
        fi
    fi
}

# --- OPTIONS -----------------------------------
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--voice)
            if [[ -z "${2:-}" ]]; then
                echo "Error: -v/--voice requires an argument."
                usage
            fi
            MODEL="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

set -- "${args[@]}"

# --- MAIN -----------------------------------
main() {
    [ $# -eq 0 ] && usage # no input

    ensure_piper
    ensure_model

    local piper_flags=(--model "$MODEL_PATH" --length-scale 0.9 --volume 0.8 --output-raw)
    local play_cmd=(aplay -r 22050 -f S16_LE -t raw -q -)
    local interrupted=0; trap 'interrupted=1' INT

    echo "Playing..."
    {
        if [ -f "$1" ]; then # file input
            piper-tts "${piper_flags[@]}" -i "$1" 2>/dev/null | "${play_cmd[@]}"
        elif [ -n "$1" ]; then # text input
            echo "$1" | piper-tts "${piper_flags[@]}" | "${play_cmd[@]}"
        fi
    } &>/dev/null || true

    trap - INT; [[ $interrupted -eq 1 ]] && echo "Stopped." || echo "Done."
}

main "$@"

